{
  "name": "EPU",
  "owner_address": ["sir", "boss"],
  "assistant_name": "EPU",

  "bind": "127.0.0.1",
  "ports": {
    "hud": 8790,
    "stream": 8792,
    "api": 8791
  },

  "providers": {
    "local_enabled": false,
    "local_jobs": [
      {
        "id": "openjarvis",
        "label": "OpenJarvis (local brains)",
        "base": "http://127.0.0.1:11434/v1",
        "model_env": "EPU_OPENJARVIS_MODEL",
        "model": "qwen3.5:2b",
        "priority": 7,
        "max_tokens": 1024,
        "temperature": 0.3,
        "timeout_s": 120,
        "note": "OpenJarvis serves an OpenAI-compatible endpoint; turn it on with EPU_LOCAL=1"
      }
    ],
    "cloud": [
      {
        "id": "nvidia",
        "label": "NVIDIA NIM",
        "base": "https://integrate.api.nvidia.com/v1",
        "key_env": ["EPU_NVIDIA_KEY_1", "EPU_NVIDIA_KEY_2"],
        "models": [
          "nvidia/nemotron-3.5-bolt-e4b",
          "poolside/laguna-xs-2.1",
          "mistralai/mistral-large-4-1t-a52b"
        ],
        "priority": 5,
        "max_tokens": 1024,
        "temperature": 0.3,
        "timeout_s": 20
      }
    ]
  },

  "policy": {
    "chat": {
      "short_term_items": 40,
      "short_term_ttl_hours": 24,
      "recall_k": 6
    },
    "read_roots": ["projects", "docs", "memory", "config"],
    "write_roots": ["projects"]
  },

  "projects": {
    "easyphoneunlocker": {
      "title": "easyphoneunlocker.com",
      "kind": "client",
      "memory_scope": "client:easyphoneunlocker",
      "path": "projects/easyphoneunlocker",
      "site": "https://easyphoneunlocker.com",
      "hosting": "hostinger cloud business",
      "dns": {
        "nameservers": ["ns1.dns-parking.com", "ns2.dns-parking.com"],
        "a": ["147.79.69.109", "93.127.173.40"]
      }
    },
    "testing": {
      "title": "EPU test site (free domain)",
      "kind": "project",
      "memory_scope": "client:testing",
      "path": "projects/testing",
      "site": "https://epu.us.kg",
      "note": "free DigitalPlat domain for testing, registered by the owner; .com stays parked"
    }
  },

  "automation": {
    "base": "http://127.0.0.1:8080",
    "timeout_s": 30,
    "note": "ActivePieces (or any webhook engine): optional hands for EPU, off until it runs"
  },

  "installs": {
    "first_run": true
  }
}
